<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear/><add value="index.html"/></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Custom"><remove statusCode="404"/><error statusCode="404" path="/404.html" responseMode="ExecuteURL"/></httpErrors>
  </system.webServer>
</configuration>
